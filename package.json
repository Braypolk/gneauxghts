{
  "name": "gneauxghts",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "agent:serve": "node e2e/agent/serve.mjs",
    "agent:session": "pnpm --dir e2e/agent exec wdio session",
    "agent:test": "pnpm --dir e2e/agent exec wdio run ./wdio.conf.js",
    "dev": "vite dev",
    "atlas:lab": "VITE_E2E_BROWSER=true node scripts/atlasPrototype.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "pnpm test:support && vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run --reporter=default",
    "test:support": "node --test e2e/support/*.test.mjs",
    "test:build:artifacts": "node --test scripts/tests/rustBuildArtifacts.test.mjs",
    "clean:rust:debug": "cargo clean --manifest-path src-tauri/Cargo.toml --profile dev",
    "test:e2e": "pnpm test:e2e:browser",
    "test:e2e:browser": "wdio run e2e/wdio.browser.conf.ts",
    "test:timeline:scale": "cargo test --release --manifest-path src-tauri/Cargo.toml release_window_fixture -- --ignored --nocapture",
    "test:timeline:contracts:ts": "vitest run src/lib/contracts/timelineContractFixtures.test.ts",
    "test:timeline:contracts:rust": "cargo test --manifest-path src-tauri/Cargo.toml timeline_command_fixture_matches_every_serialized_rust_state",
    "test:timeline:contracts": "pnpm test:timeline:contracts:ts && pnpm test:timeline:contracts:rust",
    "test:e2e:native:build": "node e2e/support/buildNative.mjs",
    "test:e2e:native:run": "node e2e/support/nativeSuite.mjs smoke",
    "test:e2e:native": "pnpm test:timeline:contracts && pnpm test:e2e:native:build && pnpm test:e2e:native:run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm check:e2e",
    "check:e2e": "tsc --project e2e/tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "node scripts/tauri.mjs",
    "release:mac": "GNEAUXGHTS_REQUIRE_NOTARIZATION=1 node scripts/tauri.mjs build",
    "test:timeline:fixture:create": "python3 scripts/timeline_fixture.py create",
    "test:timeline:fixture:reuse": "python3 scripts/timeline_fixture.py check",
    "test:timeline:fixture:reset": "python3 scripts/timeline_fixture.py reset",
    "test:timeline:fixture:checks": "python3 -B -m unittest discover -s scripts/tests -v",
    "test:timeline:stages": "cargo test --release --manifest-path src-tauri/Cargo.toml release_write_stages -- --ignored --nocapture",
    "test:timeline:native:build": "node e2e/support/buildNative.mjs --release",
    "test:timeline:native": "python3 scripts/timeline_fixture.py native",
    "test:e2e:native:list": "node e2e/support/nativeSuite.mjs smoke --list",
    "test:e2e:native:measurement": "node e2e/support/nativeSuite.mjs measurement",
    "animation:lab": "node scripts/animationLab.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "6.43.1",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@floating-ui/dom": "^1.8.0",
    "@internationalized/date": "^3.12.4",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "bits-ui": "^2.20.0",
    "clsx": "^2.1.1",
    "diff": "9.0.0",
    "markdown-it": "^15.0.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "@wdio/types": "10.1.0",
    "esbuild": "0.28.2",
    "expect-webdriverio": "8.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webdriverio": "10.1.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
